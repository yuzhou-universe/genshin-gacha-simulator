# ============================================================
# 复制为 .env 后按需修改。.env 已被 .gitignore 忽略，不会入库。
# ============================================================

# ---------- 应用 ----------
APP_NAME="原神风格抽卡模拟系统"
DEBUG=true
# Session 签名密钥。生产环境必须改成随机长字符串：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-change-me-in-production
SESSION_MAX_AGE=1209600

# ---------- 数据库 ----------
# 开发（默认，零配置）：SQLite
DATABASE_URL=sqlite+aiosqlite:///./gacha.db
# 生产（PostgreSQL）示例：
# DATABASE_URL=postgresql+asyncpg://gacha:gacha@db:5432/gacha

# ---------- docker compose 用到的变量 ----------
# 仅在 docker compose up 时生效；直接跑 uvicorn 时用不到这些。
APP_PORT=8000
POSTGRES_USER=gacha
POSTGRES_PASSWORD=gacha
POSTGRES_DB=gacha

# ---------- 管理员引导 ----------
# 首次启动自动创建管理员；已存在且密码变更时会同步覆盖。
# 生产环境务必修改！
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin12345

# ---------- 登录安全 ----------
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300

# ---------- 新用户初始货币 ----------
INITIAL_PRIMOGEMS=16000
INITIAL_INTERTWINED_FATE=20
INITIAL_ACQUAINT_FATE=20

# ---------- 原石自助增加 ----------
# 抽卡界面货币栏「+」可选的档位（逗号分隔）。服务端按此白名单校验，
# 客户端改不了：传列表以外的数值一律 422。
PRIMOGEM_TOPUP_OPTIONS=10,160,1600
# 原石余额上限。到达后「+」会禁用；已超过上限时余额保持不变，只会被调高。
PRIMOGEM_TOPUP_CAP=500000

# ---------- DeepSeek Flash ----------
# 不填 API Key 时，AI 功能自动降级为本地模板，抽卡不受任何影响。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT=8
DEEPSEEK_MAX_RETRIES=2
# Flash 默认开启 thinking，生成短点评必须关闭，否则延迟/成本浪费在思维链上。
DEEPSEEK_DISABLE_THINKING=true

# ---------- 上传 ----------
UPLOAD_MAX_BYTES=5242880
